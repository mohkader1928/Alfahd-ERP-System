# Secrets — never commit real credentials. .env.example/.env.local.example
# files are templates and ARE tracked; anything without ".example" is not.
.env
.env.production
.env.local
.env.migrate
.env.migrate.production
!.env.example
!.env.migrate.example

# Backend
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# Uploaded entity images (dev bind-mounts ../backend:/app, so these land
# on the host at backend/media/ — never real content to commit).
backend/media/

# Uploaded document attachments — same reasoning, separate directory (see
# Settings.attachments_root's docstring for why it's not under media/).
backend/attachments/

# Frontend
node_modules/
.next/
next-env.d.ts

# OS/editor
.DS_Store
