# Database
DATABASE_URL=postgresql+asyncpg://erp:erp_dev_password@postgres:5432/erp_nucleus
DATABASE_URL_SYNC=postgresql+psycopg2://erp:erp_dev_password@postgres:5432/erp_nucleus

# Redis (cache + Celery broker, per Phase 8 §5)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
LOG_LEVEL=INFO
