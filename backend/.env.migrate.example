# Phase 17C-RLS: environment for the one-off `migrate` compose service only
# (`docker compose --profile tools run --rm migrate`). Never used by the
# long-running api/worker services — see docs/17c-rls-runtime-role-hardening.md.
#
# Copy to backend/.env.migrate (dev) or backend/.env.migrate.production
# (prod-verification / real deploy) and fill in real values. Both are
# gitignored — DO NOT commit real credentials.

# Bootstrap credentials — the PostgreSQL superuser the official postgres
# image creates from POSTGRES_USER/POSTGRES_PASSWORD. Used ONLY by
# `bootstrap_db_roles.py` to create/configure erp_migrate and erp_app; not
# used by Alembic itself and never seen by api/worker. Plain postgres URI
# (no `+psycopg2` suffix) — this script connects via psycopg2 directly.
DATABASE_URL_BOOTSTRAP_SYNC=postgresql://<bootstrap_user>:<bootstrap_password>@postgres:5432/<db>
POSTGRES_DB=<db>

# Passwords bootstrap_db_roles.py will (re)assert on erp_migrate/erp_app —
# pick real random values for anything beyond local dev.
ERP_MIGRATE_PASSWORD=<erp_migrate_password>
ERP_APP_PASSWORD=<erp_app_password>

# Migration connection — erp_migrate, the schema-owning role. Read by
# migrations/env.py via DATABASE_URL_MIGRATE_SYNC in preference to
# DATABASE_URL_SYNC below.
DATABASE_URL_MIGRATE_SYNC=postgresql+psycopg2://erp_migrate:<erp_migrate_password>@postgres:5432/<db>

# Settings() requires these fields to construct even though Alembic itself
# never uses them — harmless to point at the same migration role.
DATABASE_URL=postgresql+asyncpg://erp_migrate:<erp_migrate_password>@postgres:5432/<db>
DATABASE_URL_SYNC=postgresql+psycopg2://erp_migrate:<erp_migrate_password>@postgres:5432/<db>
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=<unused-by-migrations-but-required-by-settings>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_ENV=production
LOG_LEVEL=INFO
